# RestoStock — variables de entorno para docker-compose.yml / infrastructure/opentofu
# Copia este archivo a .env (nunca commiteado, ver .gitignore) y sustituye los placeholders.
# Prohibido escribir valores reales aquí (AGENTS.md §3 — NEVER Commit Real Secrets).

POSTGRES_USER=YOUR_KEY_HERE
POSTGRES_PASSWORD=YOUR_KEY_HERE
POSTGRES_DB=restostock

# JWT_SECRET: minimo 32 caracteres de entropia real en produccion, sin las substrings
# "dev"/"default" (Guard 14 de AGENTS.md — environment.ts lo valida Fail-Fast al arrancar)
JWT_SECRET=YOUR_KEY_HERE

# CORS_ALLOWED_ORIGINS: obligatorio en produccion, prohibido el comodin "*" (Guard 14).
# Lista separada por comas de origenes exactos (ej. "https://app.dominio.com,https://admin.dominio.com").
CORS_ALLOWED_ORIGINS=http://localhost

# Rate limiting global para /api/v1/* (Guard 16) — opcional, valores por defecto razonables
# si se omiten. El endpoint de login tiene ademas su propio limite mas estricto, fijo.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Bootstrap idempotente del primer administrador (TK-051). Sin SEED_ADMIN_PIN, una base
# de datos nueva no tiene forma de crear usuarios via la API — POST /api/v1/auth/users
# exige ya ser ADMIN. Se aplica una sola vez (upsert por id fijo, reintentable sin riesgo).
SEED_ADMIN_PIN=YOUR_KEY_HERE
SEED_ADMIN_NAME=Administrador

# ENCRYPTION_KEY: clave DEDICADA para cifrar credenciales de terceros (API keys de IA).
# OBLIGATORIA en produccion y debe DIFERIR de JWT_SECRET (AUDIT-SEC-004 / TK-133) —
# docker-compose.yml arranca con NODE_ENV=production, asi que sin ella el backend aborta.
ENCRYPTION_KEY=YOUR_KEY_HERE

# CLIENT_ORIGIN (opcional): origen canonico del frontend para el enlace del email de
# recuperacion de PIN. Si se omite, se usa el primer origen concreto de
# CORS_ALLOWED_ORIGINS; el header `Origin` de la peticion nunca se confia (TK-133).
CLIENT_ORIGIN=

# Puerto del host donde se publica el frontend (por defecto 8080).
FRONTEND_PORT=8080

# Anti-fuerza bruta del login (Guard 16). Subir en locales con varias terminales
# detras de la misma IP publica (NAT compartido) — ver TK-132.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
