# ==============================================================================
# RestoStock Backend Environment Configuration Template (.env.example)
# Copy this template to .env before starting the application locally
# ==============================================================================

# Server HTTP Port
PORT=3000

# Application Environment (development | test | production)
NODE_ENV=development

# Security JWT Signing Secret (Replace with a strong secret key min 32 chars)
JWT_SECRET="YOUR_JWT_SECRET_KEY_HERE_MIN_32_CHARS"

# Dedicated key for encrypting stored third-party credentials (AI API keys). MUST differ from
# JWT_SECRET (AUDIT-SEC-004). Required in production — the app aborts on startup without it.
ENCRYPTION_KEY="YOUR_SEPARATE_ENCRYPTION_KEY_HERE_MIN_16_CHARS"

# Canonical frontend origin for the PIN-recovery email link. Optional if CORS_ALLOWED_ORIGINS
# is a concrete allowlist; the request `Origin` header is never trusted unless it is on it.
CLIENT_ORIGIN="https://your-frontend.example.com"

# SMTP server for the PIN-recovery email (TK-179 / INC-002). Optional: without SMTP_HOST the
# email is NOT sent (startup warning only). With SMTP_HOST, SMTP_FROM is required; SMTP_USER and
# SMTP_PASS go together. SMTP_SECURE=true for implicit TLS (465); false uses STARTTLS (587), which
# is mandatory unless SMTP_REQUIRE_TLS=false — accepted only outside production (AUDIT-DEV-018).
# With SMTP_HOST and CORS_ALLOWED_ORIGINS="*", CLIENT_ORIGIN becomes mandatory.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER="YOUR_SMTP_USER_HERE"
SMTP_PASS="YOUR_SMTP_PASSWORD_HERE"
SMTP_FROM="RestoStock <no-reply@your-domain.example.com>"

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/YOUR_POSTGRES_DB?schema=public"

# CORS Allowed Origins (Comma-separated or * for wildcard dev)
CORS_ALLOWED_ORIGINS="*"

# Rate Limiting Controls (Window in ms, Max requests per REAL client IP — needs trust proxy, AUDIT-SEC-003)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
# Login / forgot-pin / reset-pin anti-brute-force (Guard 16). Raise for shared-NAT sites (several terminals behind one IP).
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

